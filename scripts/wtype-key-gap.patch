+
+// Explicit key commands (-k/-P/-p) used to get logical code N as their evdev
+// code, so the first one landed on Escape (1), the next on "1" (2) and so on.
+// Chromium reads the physical code: an Enter sent on Escape's position never
+// produced a newline. Put named keys on their real positions and anything
+// else on a printable position (or the old code past the printable range).
+struct named_code { xkb_keysym_t sym; unsigned int code; };
+static const struct named_code named_codes[] = {
+	{XKB_KEY_Escape, 1}, {XKB_KEY_BackSpace, 14}, {XKB_KEY_Tab, 15},
+	{XKB_KEY_Return, 28}, {XKB_KEY_Control_L, 29}, {XKB_KEY_Shift_L, 42},
+	{XKB_KEY_Shift_R, 54}, {XKB_KEY_Alt_L, 56}, {XKB_KEY_Caps_Lock, 58},
+	{XKB_KEY_F1, 59}, {XKB_KEY_F2, 60}, {XKB_KEY_F3, 61}, {XKB_KEY_F4, 62},
+	{XKB_KEY_F5, 63}, {XKB_KEY_F6, 64}, {XKB_KEY_F7, 65}, {XKB_KEY_F8, 66},
+	{XKB_KEY_F9, 67}, {XKB_KEY_F10, 68}, {XKB_KEY_F11, 87}, {XKB_KEY_F12, 88},
+	{XKB_KEY_KP_Enter, 96}, {XKB_KEY_Control_R, 97}, {XKB_KEY_Alt_R, 100},
+	{XKB_KEY_Home, 102}, {XKB_KEY_Up, 103}, {XKB_KEY_Page_Up, 104},
+	{XKB_KEY_Left, 105}, {XKB_KEY_Right, 106}, {XKB_KEY_End, 107},
+	{XKB_KEY_Down, 108}, {XKB_KEY_Page_Down, 109}, {XKB_KEY_Insert, 110},
+	{XKB_KEY_Delete, 111}, {XKB_KEY_Super_L, 125}, {XKB_KEY_Super_R, 126},
+};
+
+static int named_code_for(xkb_keysym_t sym)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(named_codes); i++) {
+		if (named_codes[i].sym == sym) {
+			return (int)named_codes[i].code;
+		}
+	}
+	return -1;
+}
+
+// evdev code for one-indexed logical code `key_code` outside literal mode.
+static unsigned int explicit_code(struct wtype *wtype, unsigned int key_code)
+{
+	int named = named_code_for(wtype->keymap[key_code - 1].xkb);
+	if (named >= 0) {
+		return (unsigned int)named;
+	}
+	size_t other = 0;
+	for (unsigned int i = 0; i + 1 < key_code; i++) {
+		if (named_code_for(wtype->keymap[i].xkb) < 0) {
+			other++;
+		}
+	}
+	if (other < ARRAY_SIZE(text_keycodes)) {
+		return text_keycodes[other];
+	}
+	return 130 + key_code;
+}
+
 static void run_key(struct wtype *wtype, struct wtype_command *cmd)
 {
 	zwp_virtual_keyboard_v1_key(
-		wtype->keyboard, 0, cmd->single_key_code,
+		wtype->keyboard, 0, explicit_code(wtype, cmd->single_key_code),
 		cmd->type == WTYPE_COMMAND_KEY_PRESS ?
 			WL_KEYBOARD_KEY_STATE_PRESSED : WL_KEYBOARD_KEY_STATE_RELEASED
 	);
 	wl_display_roundtrip(wtype->display);
 }
 
+static unsigned key_gap_us(void)
+{
+	static int v = -1;
+	if (v < 0) {
+		const char *e = getenv("WTYPE_KEY_GAP_US");
+		v = e ? atoi(e) : 2000;
+	}
+	return (unsigned)v;
+}
